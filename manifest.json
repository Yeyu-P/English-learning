{
  "manifest_version": 3,
  "name": "Subtract",
  "version": "1.1",
  "description": "Capture subtitles from any video. Extract English with AI.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Subtract"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "capture-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Full screen capture + AI analysis"
    },
    "capture-screenshot-manual": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Select area to capture + AI analysis"
    }
  }
}
